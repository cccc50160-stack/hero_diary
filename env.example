# Copy this file to .env and fill in real values. Never commit the real .env.

# From @BotFather after /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Postgres connection string. Free options: Neon (neon.tech), Supabase, Render Postgres.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://liferpg:liferpg_dev@localhost:5432/liferpg

# Most hosts (Render/Railway/Fly) inject PORT automatically — only needed for local runs.
PORT=3000

# Set to "true" only while testing locally outside Telegram (see README) — never in production.
ALLOW_UNAUTHENTICATED_DEV=false

# Общий секрет для внешнего крона, который дёргает /api/cron/reminders?key=...
# Без него эндпоинт отвечает 403 всем подряд и пуши просто не уходят.
# Сгенерировать свой:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Настройка самого пингера — в DEPLOY.md, раздел «Пуш-напоминания».
CRON_SECRET=replace-me-with-a-long-random-string

# Ссылка, которая подставляется в кнопку под текстом пуша. Если не задать — t.me/herodiary_bot.
MINIAPP_URL=https://t.me/herodiary_bot
